# Copy to .env.email (git-ignored) and fill in, then:
#   npm run email:configure -- --dry-run
#   npm run email:configure
# These values never go in .env.local and never reach the browser.

# Supabase: project ref (dashboard URL) and a personal access token from
# https://supabase.com/dashboard/account/tokens (revoke it afterwards if you like).
SUPABASE_PROJECT_REF=replace-me
SUPABASE_ACCESS_TOKEN=replace-me

# SMTP sender. Example: a mailbox created only for the app, with two-step verification
# turned on and an "app password" (not the mailbox password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me@gmail.com
SMTP_PASS=replace-me

# Optional. The sender address defaults to SMTP_USER; set it when the SMTP login is not
# an email address (Brevo, Resend...). Mailbox providers ignore a From they do not own.
# SMTP_SENDER_EMAIL=
# SMTP_SENDER_NAME=D-Klothes
# Project-wide ceiling of auth emails per hour. Stay well under the provider's daily cap.
# EMAIL_RATE_LIMIT_PER_HOUR=30
